config {
  type: "operations",
  name: "ads_collartandroid_oper_user_active_di",
  schema: "ads_collartandroid",
  dependencies: [
    "h_dm_collart_android_user_event_di",
    "h_dws_oper_user_sub_revenue_df",
    "h_dws_oper_user_ad_di"
  ]
}

/*
  Collart Android 第二张表：用户日事实表（活跃 ∪ 当日有收入）
  Dataform: definitions/ads/collart/collart_android/ads_oper_user_active_di.sqlx
  目标表  : aidata2025.ads_collartandroid.ads_oper_user_active_di

  口径要点（依据用户确认）:
  - 粒度: event_date × user_pseudo_id；行 = 当日活跃 OR 当日有订阅/广告收入。
  - is_active = 当日存在 user_engagement/screen_view/app_exception/first_open 任一事件（落表）。
  - 付费-only 行 is_active=FALSE；维度取最近一次活跃快照；retain/churn/return 仅基于活跃日。
  - 下游: DAU/新增/留存/流失/回流滤 is_active；SUM(revenue) 不过滤。
  - is_new   = 当日存在 first_open（付费-only 为 FALSE）。
  - is_churn = 该活跃日后 14 日均未再次活跃；未来观察窗未完整时置 NULL。
  - is_return = 当日活跃、非新增，且此前 14 日均未活跃；历史观察窗不足时置 NULL。
  - identity / geo / device / traffic_src 结构与上游 dm_collart_android_user_event_di 保持一致，
    维度默认取「当日最后一个事件」快照；atlasv_uid 直接取 DM identity。
  - first_open_time 即老表 register_time（已改名）：取 DM 当日 first_open 事件时间，
    不能从当日最后事件快照取值；不再依赖旧 DWD。
  - subscription:
      product_ids       当日 vip_subscribe_succeed 命中的商品（去重合并，ARRAY）
      purchase_cnt      当日付费成功次数（vip_subscribe_succeed）
      is_subscribe      当日是否订阅（product_id LIKE 'collart_premium%'）
      is_credit_pack    当日是否购买点数包（product_id LIKE 'credits_pack%'）
      credit_pack_cnt   当日点数包购买次数
      credit_amount     当日购买点数数量（从 credits_pack_*_N 商品名尾号解析求和）
      sub_in_7d         次日起 7 天内是否发生订阅（date_diff 1..7，前视窗口）
      credit_pack_in_7d 次日起 7 天内是否购买点数包
  - revenue（当日购买贡献，来自 dws 权威收入表，按当日归属）:
      purchase_revenue      = dws.total_revenue_today（= SUM(全部订单 revenue)，**已含点数包**）
      resub_revenue         = dws.resub_revenue_today（subscribe_type=renew）
      new_revenue           = dws.new_revenue_today - credit_revenue_today（首购订阅，**不含点数包**）
      trial_conver_revenue  = dws.trial_conver_revenue_today
      credit_revenue        = dws.credit_revenue_today（order_type=点数包，是 total 的子集）
      ad_revenue            = dws_oper_user_ad_di.ad_value
      俄罗斯收银（RUB）叠加 Stripe `dwd_cdct_revenue_stripe_di`（app_name=collart_android）：
      金额加进 purchase_revenue 与 credit_revenue（与历史 ads_ad_sub 俄收入全算点数包一致）
      注: 勿再 purchase=total+credit，会把点数双计；total ≈ new+resub+trial+credit（四桶互斥）
  - retain / rolling_retain: 以每个活跃日为锚点（rolling cohort）；字段编号对齐旧表 retain_N。
      retain.dN         = 锚点后第 (N-1) 天当天活跃（date_diff = N-1）；**retain.d2 = 次日**
      rolling_retain.dN = 锚点后 [1, N-1] 天内任一天活跃（累计留存）
      字段范围 d2–d30（无 d1）；前视未到期置 NULL，随每日回刷逐步定稿。

  刷新窗口: 为覆盖 29 日前视留存，DELETE/INSERT 回刷 [biz_date-30, biz_date]。
*/

DECLARE from_date DATE DEFAULT ${dataform.projectConfig.vars.biz_date} - 30;
DECLARE to_date   DATE DEFAULT ${dataform.projectConfig.vars.biz_date};
DECLARE source_from_date DATE DEFAULT from_date - 14;

CREATE TABLE IF NOT EXISTS `aidata2025.ads_collartandroid.ads_oper_user_active_di`
(
  package_name STRING,
  app_name STRING,
  event_date DATE,
  user_pseudo_id STRING,
  user_id STRING,
  country STRING,
  app_version STRING,
  is_new BOOL,
  is_churn BOOL,
  is_return BOOL,
  is_remove BOOL,
  is_login BOOL,
  is_active BOOL,
  is_vip STRING,
  first_open_time TIMESTAMP,
  traffic_src_name STRING,
  traffic_src_type STRING,
  traffic_src_platform STRING,
  identity STRUCT<
    atlasv_uid STRING,
    android_id STRING,
    adjust_id STRING,
    advertising_id STRING
  >,
  geo STRUCT<
    city STRING,
    continent STRING,
    sub_continent STRING
  >,
  device STRUCT<
    category STRING,
    mobile_brand_name STRING,
    mobile_model_name STRING,
    operating_system STRING,
    operating_system_version STRING,
    os_sdk_version STRING,
    vendor_id STRING,
    language STRING,
    installer_package_name STRING
  >,
  traffic_src STRUCT<
    medium STRING,
    source STRING,
    fb_campaign STRING,
    adjust_network STRING,
    adjust_tracker_name STRING,
    adjust_campaign_name STRING,
    adjust_adgroup STRING,
    campaign_info_source STRING,
    install_referer_url STRING,
    gclid STRING,
    gad_source STRING,
    gad_campaign_id STRING,
    utm_source STRING,
    utm_medium STRING
  >,
  subscription STRUCT<
    product_ids ARRAY<STRING>,
    purchase_cnt INT64,
    is_subscribe BOOL,
    is_credit_pack BOOL,
    credit_pack_cnt INT64,
    credit_amount INT64,
    sub_in_7d BOOL,
    credit_pack_in_7d BOOL,
    is_purchase BOOL
  >,
  revenue STRUCT<
    purchase_revenue FLOAT64,
    resub_revenue FLOAT64,
    new_revenue FLOAT64,
    trial_conver_revenue FLOAT64,
    credit_revenue FLOAT64,
    ad_revenue FLOAT64
  >,
  retain STRUCT<
    d2 BOOL,
    d3 BOOL,
    d4 BOOL,
    d5 BOOL,
    d6 BOOL,
    d7 BOOL,
    d8 BOOL,
    d9 BOOL,
    d10 BOOL,
    d11 BOOL,
    d12 BOOL,
    d13 BOOL,
    d14 BOOL,
    d15 BOOL,
    d16 BOOL,
    d17 BOOL,
    d18 BOOL,
    d19 BOOL,
    d20 BOOL,
    d21 BOOL,
    d22 BOOL,
    d23 BOOL,
    d24 BOOL,
    d25 BOOL,
    d26 BOOL,
    d27 BOOL,
    d28 BOOL,
    d29 BOOL,
    d30 BOOL
  >,
  rolling_retain STRUCT<
    d2 BOOL,
    d3 BOOL,
    d4 BOOL,
    d5 BOOL,
    d6 BOOL,
    d7 BOOL,
    d8 BOOL,
    d9 BOOL,
    d10 BOOL,
    d11 BOOL,
    d12 BOOL,
    d13 BOOL,
    d14 BOOL,
    d15 BOOL,
    d16 BOOL,
    d17 BOOL,
    d18 BOOL,
    d19 BOOL,
    d20 BOOL,
    d21 BOOL,
    d22 BOOL,
    d23 BOOL,
    d24 BOOL,
    d25 BOOL,
    d26 BOOL,
    d27 BOOL,
    d28 BOOL,
    d29 BOOL,
    d30 BOOL
  >
)
PARTITION BY event_date
CLUSTER BY user_pseudo_id, country
OPTIONS (
  description = 'Collart Android 用户日事实：活跃∪当日收入，含 is_active/订阅/收入/前视留存'
);

BEGIN TRANSACTION;

DELETE FROM `aidata2025.ads_collartandroid.ads_oper_user_active_di`
WHERE event_date BETWEEN from_date AND to_date;

INSERT INTO `aidata2025.ads_collartandroid.ads_oper_user_active_di` (
  package_name, app_name, event_date, user_pseudo_id, user_id, country, app_version,
  is_new, is_churn, is_return, is_remove, is_login, is_active, is_vip, first_open_time,
  traffic_src_name, traffic_src_type, traffic_src_platform,
  identity, geo, device, traffic_src, subscription, revenue, retain, rolling_retain
)

WITH ev AS (
  SELECT *
  FROM `aidata2025.dm.dm_collart_android_user_event_di`
  WHERE event_date BETWEEN source_from_date AND to_date
    AND user_pseudo_id IS NOT NULL
),

-- 当日事件级聚合：活跃判定 + 当日订阅/点数快照
agg AS (
  SELECT
    event_date,
    user_pseudo_id,
    COUNTIF(event_name = 'first_open') > 0 AS is_new,
    MIN(IF(event_name = 'first_open', TIMESTAMP(event_time), NULL)) AS first_open_time,
    COUNTIF(event_name IN ('user_engagement','screen_view','app_exception','first_open')) > 0 AS is_active,
    COUNTIF(event_name = 'app_remove') > 0 AS is_remove,
    LOGICAL_OR(is_vip = '2') AS any_vip2,
    COUNTIF(event_name = 'vip_subscribe_succeed') AS purchase_cnt,
    ARRAY_AGG(DISTINCT IF(event_name = 'vip_subscribe_succeed', subscription.product_id, NULL) IGNORE NULLS) AS product_ids,
    COUNTIF(event_name = 'vip_subscribe_succeed' AND subscription.product_id LIKE 'collart_premium%') > 0 AS is_subscribe,
    COUNTIF(event_name = 'vip_subscribe_succeed' AND subscription.product_id LIKE 'credits_pack%') > 0 AS is_credit_pack,
    COUNTIF(event_name = 'vip_subscribe_succeed' AND subscription.product_id LIKE 'credits_pack%') AS credit_pack_cnt,
    SUM(IF(event_name = 'vip_subscribe_succeed' AND subscription.product_id LIKE 'credits_pack%',
           SAFE_CAST(REGEXP_EXTRACT(subscription.product_id, r'(\d+)$') AS INT64), 0)) AS credit_amount
  FROM ev
  GROUP BY event_date, user_pseudo_id
),

-- 当日最后一个事件的维度快照
last_ev AS (
  SELECT * EXCEPT(rn)
  FROM (
    SELECT
      event_date, user_pseudo_id, user_id, country, app_version,
      is_login, is_vip, first_open_time, traffic_src_name, traffic_src_type, traffic_src_platform,
      identity, geo, device, traffic_src,
      ROW_NUMBER() OVER (PARTITION BY event_date, user_pseudo_id ORDER BY event_time DESC) AS rn
    FROM ev
  )
  WHERE rn = 1
),

active_all AS (
  SELECT
    a.event_date,
    a.user_pseudo_id,
    a.is_new,
    a.is_remove,
    a.purchase_cnt,
    a.product_ids,
    a.is_subscribe,
    a.is_credit_pack,
    a.credit_pack_cnt,
    a.credit_amount,
    l.user_id,
    l.country,
    l.app_version,
    l.is_login,
    TRUE AS is_active,
    -- 当日任一事件命中 '2' 即 VIP（对齐旧表 MAX(is_vip)='2' 口径）
    IF(a.any_vip2, '2', l.is_vip) AS is_vip,
    a.first_open_time,
    l.traffic_src_name,
    l.traffic_src_type,
    l.traffic_src_platform,
    l.identity,
    l.geo,
    l.device,
    l.traffic_src
  FROM agg AS a
  JOIN last_ev AS l USING (event_date, user_pseudo_id)
  WHERE a.is_active
),

active AS (
  SELECT *
  FROM active_all
  WHERE event_date BETWEEN from_date AND to_date
),

sub_rev AS (
  SELECT
    order_date AS event_date,
    user_pseudo_id,
    SUM(total_revenue_today) AS total_revenue,
    SUM(resub_revenue_today) AS resub_revenue,
    SUM(new_revenue_today - credit_revenue_today) AS new_revenue,
    SUM(trial_conver_revenue_today) AS trial_conver_revenue,
    SUM(credit_revenue_today) AS credit_revenue
  FROM `aidata2025.dws.dws_oper_user_sub_revenue_df`
  WHERE order_date BETWEEN from_date AND to_date
    AND LOWER(app_name) = 'collart_android'
  GROUP BY order_date, user_pseudo_id
),

ad_rev AS (
  SELECT
    event_date,
    user_pseudo_id,
    SUM(ad_value) AS ad_revenue
  FROM `aidata2025.dws.dws_oper_user_ad_di`
  WHERE event_date BETWEEN from_date AND to_date
    AND LOWER(app_name) = 'collart_android'
  GROUP BY event_date, user_pseudo_id
),

rub_raw AS (
  SELECT
    event_date,
    TRIM(CAST(user_id AS STRING)) AS user_id,
    ROUND(IFNULL(revneue, 0) + IFNULL(fee, 0), 2) AS amount_usd
  FROM `pubdata2025.dwd.dwd_cdct_revenue_stripe_di`
  WHERE event_date BETWEEN from_date AND to_date
    AND IFNULL(revneue, 0) > 0
    AND user_id IS NOT NULL AND TRIM(CAST(user_id AS STRING)) != ''
    AND UPPER(currency) = 'RUB'
    AND LOWER(REPLACE(IFNULL(app_name, ''), '_', '-')) = 'collart-android'
    AND transaction_id IS NOT NULL
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY CAST(transaction_id AS STRING)
    ORDER BY event_timestamp DESC, revneue DESC
  ) = 1
),

uid_map_day AS (
  SELECT
    event_date,
    TRIM(CAST(user_id AS STRING)) AS user_id,
    ARRAY_AGG(user_pseudo_id ORDER BY event_time DESC LIMIT 1)[OFFSET(0)] AS user_pseudo_id
  FROM ev
  WHERE user_id IS NOT NULL AND TRIM(CAST(user_id AS STRING)) != ''
  GROUP BY event_date, user_id
),

uid_map_hist AS (
  SELECT
    user_id,
    ARRAY_AGG(user_pseudo_id ORDER BY event_date DESC LIMIT 1)[OFFSET(0)] AS user_pseudo_id
  FROM (
    SELECT event_date, TRIM(CAST(user_id AS STRING)) AS user_id, user_pseudo_id
    FROM ev
    WHERE user_id IS NOT NULL AND TRIM(CAST(user_id AS STRING)) != ''
    UNION ALL
    SELECT event_date, TRIM(CAST(user_id AS STRING)), user_pseudo_id
    FROM `aidata2025.ads_collartandroid.ads_oper_user_active_di`
    WHERE event_date < from_date
      AND event_date >= DATE_SUB(from_date, INTERVAL 400 DAY)
      AND user_id IS NOT NULL AND TRIM(CAST(user_id AS STRING)) != ''
  )
  GROUP BY user_id
),

rub_rev AS (
  SELECT
    r.event_date,
    COALESCE(d.user_pseudo_id, h.user_pseudo_id) AS user_pseudo_id,
    SUM(r.amount_usd) AS rub_revenue
  FROM rub_raw AS r
  LEFT JOIN uid_map_day AS d
    ON d.event_date = r.event_date AND d.user_id = r.user_id
  LEFT JOIN uid_map_hist AS h
    ON h.user_id = r.user_id
  WHERE COALESCE(d.user_pseudo_id, h.user_pseudo_id) IS NOT NULL
  GROUP BY 1, 2
),

pay_keys AS (
  SELECT event_date, user_pseudo_id
  FROM sub_rev
  WHERE IFNULL(total_revenue, 0) > 0
  UNION DISTINCT
  SELECT event_date, user_pseudo_id
  FROM ad_rev
  WHERE IFNULL(ad_revenue, 0) > 0
  UNION DISTINCT
  SELECT event_date, user_pseudo_id
  FROM rub_rev
  WHERE IFNULL(rub_revenue, 0) > 0
),

pay_only_keys AS (
  SELECT p.event_date, p.user_pseudo_id
  FROM pay_keys AS p
  LEFT JOIN active AS a USING (event_date, user_pseudo_id)
  WHERE a.user_pseudo_id IS NULL
),

dim_src AS (
  SELECT
    event_date, user_pseudo_id, user_id, country, app_version, is_login, is_vip,
    first_open_time, traffic_src_name, traffic_src_type, traffic_src_platform,
    identity, geo, device, traffic_src
  FROM active_all
  UNION ALL
  SELECT
    event_date, user_pseudo_id, user_id, country, app_version, is_login, is_vip,
    first_open_time, traffic_src_name, traffic_src_type, traffic_src_platform,
    identity, geo, device, traffic_src
  FROM `aidata2025.ads_collartandroid.ads_oper_user_active_di`
  WHERE event_date < from_date
    AND event_date >= DATE_SUB(from_date, INTERVAL 400 DAY)
    AND IFNULL(is_active, TRUE)
),

pay_only AS (
  SELECT
    p.event_date,
    p.user_pseudo_id,
    FALSE AS is_new,
    FALSE AS is_remove,
    0 AS purchase_cnt,
    CAST([] AS ARRAY<STRING>) AS product_ids,
    FALSE AS is_subscribe,
    FALSE AS is_credit_pack,
    0 AS credit_pack_cnt,
    0 AS credit_amount,
    d.user_id,
    COALESCE(d.country, 'unknown') AS country,
    d.app_version,
    COALESCE(d.is_login, FALSE) AS is_login,
    FALSE AS is_active,
    d.is_vip,
    d.first_open_time,
    d.traffic_src_name,
    d.traffic_src_type,
    d.traffic_src_platform,
    d.identity,
    d.geo,
    d.device,
    d.traffic_src
  FROM pay_only_keys AS p
  LEFT JOIN (
    SELECT * EXCEPT (rn)
    FROM (
      SELECT
        p2.event_date AS pay_date,
        p2.user_pseudo_id,
        d2.user_id,
        d2.country,
        d2.app_version,
        d2.is_login,
        d2.is_vip,
        d2.first_open_time,
        d2.traffic_src_name,
        d2.traffic_src_type,
        d2.traffic_src_platform,
        d2.identity,
        d2.geo,
        d2.device,
        d2.traffic_src,
        ROW_NUMBER() OVER (
          PARTITION BY p2.event_date, p2.user_pseudo_id
          ORDER BY d2.event_date DESC
        ) AS rn
      FROM pay_only_keys AS p2
      JOIN dim_src AS d2
        ON d2.user_pseudo_id = p2.user_pseudo_id
       AND d2.event_date <= p2.event_date
    )
    WHERE rn = 1
  ) AS d
    ON d.pay_date = p.event_date
   AND d.user_pseudo_id = p.user_pseudo_id
),

output_base AS (
  SELECT * FROM active
  UNION ALL
  SELECT * FROM pay_only
),

purch_day AS (
  SELECT
    event_date,
    user_pseudo_id,
    LOGICAL_OR(event_name = 'vip_subscribe_succeed' AND subscription.product_id LIKE 'collart_premium%') AS is_sub,
    LOGICAL_OR(event_name = 'vip_subscribe_succeed' AND subscription.product_id LIKE 'credits_pack%') AS is_credit
  FROM ev
  GROUP BY event_date, user_pseudo_id
),

fwd AS (
  SELECT
    a.event_date,
    a.user_pseudo_id,
    LOGICAL_OR(b.is_sub) AS sub_in_7d,
    LOGICAL_OR(b.is_credit) AS credit_pack_in_7d
  FROM active AS a
  LEFT JOIN purch_day AS b
    ON a.user_pseudo_id = b.user_pseudo_id
   AND DATE_DIFF(b.event_date, a.event_date, DAY) BETWEEN 1 AND 7
   AND (b.is_sub OR b.is_credit)
  GROUP BY a.event_date, a.user_pseudo_id
),

retain_flags AS (
  SELECT
    event_date,
    user_pseudo_id,
    LOGICAL_OR(diff = 1) AS r1,
    LOGICAL_OR(diff = 2) AS r2,
    LOGICAL_OR(diff = 3) AS r3,
    LOGICAL_OR(diff = 4) AS r4,
    LOGICAL_OR(diff = 5) AS r5,
    LOGICAL_OR(diff = 6) AS r6,
    LOGICAL_OR(diff = 7) AS r7,
    LOGICAL_OR(diff = 8) AS r8,
    LOGICAL_OR(diff = 9) AS r9,
    LOGICAL_OR(diff = 10) AS r10,
    LOGICAL_OR(diff = 11) AS r11,
    LOGICAL_OR(diff = 12) AS r12,
    LOGICAL_OR(diff = 13) AS r13,
    LOGICAL_OR(diff = 14) AS r14,
    LOGICAL_OR(diff = 15) AS r15,
    LOGICAL_OR(diff = 16) AS r16,
    LOGICAL_OR(diff = 17) AS r17,
    LOGICAL_OR(diff = 18) AS r18,
    LOGICAL_OR(diff = 19) AS r19,
    LOGICAL_OR(diff = 20) AS r20,
    LOGICAL_OR(diff = 21) AS r21,
    LOGICAL_OR(diff = 22) AS r22,
    LOGICAL_OR(diff = 23) AS r23,
    LOGICAL_OR(diff = 24) AS r24,
    LOGICAL_OR(diff = 25) AS r25,
    LOGICAL_OR(diff = 26) AS r26,
    LOGICAL_OR(diff = 27) AS r27,
    LOGICAL_OR(diff = 28) AS r28,
    LOGICAL_OR(diff = 29) AS r29,
    LOGICAL_OR(diff <= 1) AS rr1,
    LOGICAL_OR(diff <= 2) AS rr2,
    LOGICAL_OR(diff <= 3) AS rr3,
    LOGICAL_OR(diff <= 4) AS rr4,
    LOGICAL_OR(diff <= 5) AS rr5,
    LOGICAL_OR(diff <= 6) AS rr6,
    LOGICAL_OR(diff <= 7) AS rr7,
    LOGICAL_OR(diff <= 8) AS rr8,
    LOGICAL_OR(diff <= 9) AS rr9,
    LOGICAL_OR(diff <= 10) AS rr10,
    LOGICAL_OR(diff <= 11) AS rr11,
    LOGICAL_OR(diff <= 12) AS rr12,
    LOGICAL_OR(diff <= 13) AS rr13,
    LOGICAL_OR(diff <= 14) AS rr14,
    LOGICAL_OR(diff <= 15) AS rr15,
    LOGICAL_OR(diff <= 16) AS rr16,
    LOGICAL_OR(diff <= 17) AS rr17,
    LOGICAL_OR(diff <= 18) AS rr18,
    LOGICAL_OR(diff <= 19) AS rr19,
    LOGICAL_OR(diff <= 20) AS rr20,
    LOGICAL_OR(diff <= 21) AS rr21,
    LOGICAL_OR(diff <= 22) AS rr22,
    LOGICAL_OR(diff <= 23) AS rr23,
    LOGICAL_OR(diff <= 24) AS rr24,
    LOGICAL_OR(diff <= 25) AS rr25,
    LOGICAL_OR(diff <= 26) AS rr26,
    LOGICAL_OR(diff <= 27) AS rr27,
    LOGICAL_OR(diff <= 28) AS rr28,
    LOGICAL_OR(diff <= 29) AS rr29
  FROM (
    SELECT
      a.event_date,
      a.user_pseudo_id,
      DATE_DIFF(b.event_date, a.event_date, DAY) AS diff
    FROM active AS a
    JOIN active_all AS b
      ON a.user_pseudo_id = b.user_pseudo_id
     AND DATE_DIFF(b.event_date, a.event_date, DAY) BETWEEN 1 AND 29
  )
  GROUP BY event_date, user_pseudo_id
),

coverage AS (
  SELECT MIN(event_date) AS min_event_date
  FROM ev
),

lifecycle_flags AS (
  SELECT
    a.event_date,
    a.user_pseudo_id,
    IF(
      DATE_ADD(a.event_date, INTERVAL 14 DAY) > to_date,
      NULL,
      NOT EXISTS (
        SELECT 1
        FROM active_all AS n
        WHERE n.user_pseudo_id = a.user_pseudo_id
          AND DATE_DIFF(n.event_date, a.event_date, DAY) BETWEEN 1 AND 14
      )
    ) AS is_churn,
    IF(
      a.is_new,
      FALSE,
      IF(
        DATE_SUB(a.event_date, INTERVAL 14 DAY) < c.min_event_date,
        NULL,
        NOT EXISTS (
          SELECT 1
          FROM active_all AS p
          WHERE p.user_pseudo_id = a.user_pseudo_id
            AND DATE_DIFF(a.event_date, p.event_date, DAY) BETWEEN 1 AND 14
        )
      )
    ) AS is_return
  FROM active AS a
  CROSS JOIN coverage AS c
)

SELECT
  'free.ai.photo.generator.collart.ai' AS package_name,
  'collart_android' AS app_name,
  f.event_date,
  f.user_pseudo_id,
  f.user_id,
  f.country,
  f.app_version,
  f.is_new,
  lf.is_churn,
  lf.is_return,
  f.is_remove,
  f.is_login,
  f.is_active,
  f.is_vip,
  f.first_open_time,
  f.traffic_src_name,
  f.traffic_src_type,
  f.traffic_src_platform,
  f.identity,
  f.geo,
  f.device,
  f.traffic_src,
  STRUCT(
    f.product_ids AS product_ids,
    f.purchase_cnt AS purchase_cnt,
    f.is_subscribe AS is_subscribe,
    f.is_credit_pack AS is_credit_pack,
    f.credit_pack_cnt AS credit_pack_cnt,
    f.credit_amount AS credit_amount,
    IF(DATE_ADD(f.event_date, INTERVAL 7 DAY) > to_date, NULL, COALESCE(fw.sub_in_7d, FALSE)) AS sub_in_7d,
    IF(DATE_ADD(f.event_date, INTERVAL 7 DAY) > to_date, NULL, COALESCE(fw.credit_pack_in_7d, FALSE)) AS credit_pack_in_7d,
    (f.is_subscribe OR f.is_credit_pack) AS is_purchase
  ) AS subscription,
  STRUCT(
    COALESCE(sr.total_revenue, 0.0) + COALESCE(rr.rub_revenue, 0.0) AS purchase_revenue,
    COALESCE(sr.resub_revenue, 0.0) AS resub_revenue,
    COALESCE(sr.new_revenue, 0.0) AS new_revenue,
    COALESCE(sr.trial_conver_revenue, 0.0) AS trial_conver_revenue,
    COALESCE(sr.credit_revenue, 0.0) + COALESCE(rr.rub_revenue, 0.0) AS credit_revenue,
    COALESCE(ar.ad_revenue, 0.0) AS ad_revenue
  ) AS revenue,
  STRUCT(
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 1 DAY) > to_date, NULL, COALESCE(rf.r1, FALSE)) AS d2,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 2 DAY) > to_date, NULL, COALESCE(rf.r2, FALSE)) AS d3,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 3 DAY) > to_date, NULL, COALESCE(rf.r3, FALSE)) AS d4,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 4 DAY) > to_date, NULL, COALESCE(rf.r4, FALSE)) AS d5,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 5 DAY) > to_date, NULL, COALESCE(rf.r5, FALSE)) AS d6,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 6 DAY) > to_date, NULL, COALESCE(rf.r6, FALSE)) AS d7,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 7 DAY) > to_date, NULL, COALESCE(rf.r7, FALSE)) AS d8,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 8 DAY) > to_date, NULL, COALESCE(rf.r8, FALSE)) AS d9,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 9 DAY) > to_date, NULL, COALESCE(rf.r9, FALSE)) AS d10,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 10 DAY) > to_date, NULL, COALESCE(rf.r10, FALSE)) AS d11,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 11 DAY) > to_date, NULL, COALESCE(rf.r11, FALSE)) AS d12,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 12 DAY) > to_date, NULL, COALESCE(rf.r12, FALSE)) AS d13,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 13 DAY) > to_date, NULL, COALESCE(rf.r13, FALSE)) AS d14,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 14 DAY) > to_date, NULL, COALESCE(rf.r14, FALSE)) AS d15,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 15 DAY) > to_date, NULL, COALESCE(rf.r15, FALSE)) AS d16,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 16 DAY) > to_date, NULL, COALESCE(rf.r16, FALSE)) AS d17,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 17 DAY) > to_date, NULL, COALESCE(rf.r17, FALSE)) AS d18,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 18 DAY) > to_date, NULL, COALESCE(rf.r18, FALSE)) AS d19,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 19 DAY) > to_date, NULL, COALESCE(rf.r19, FALSE)) AS d20,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 20 DAY) > to_date, NULL, COALESCE(rf.r20, FALSE)) AS d21,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 21 DAY) > to_date, NULL, COALESCE(rf.r21, FALSE)) AS d22,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 22 DAY) > to_date, NULL, COALESCE(rf.r22, FALSE)) AS d23,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 23 DAY) > to_date, NULL, COALESCE(rf.r23, FALSE)) AS d24,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 24 DAY) > to_date, NULL, COALESCE(rf.r24, FALSE)) AS d25,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 25 DAY) > to_date, NULL, COALESCE(rf.r25, FALSE)) AS d26,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 26 DAY) > to_date, NULL, COALESCE(rf.r26, FALSE)) AS d27,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 27 DAY) > to_date, NULL, COALESCE(rf.r27, FALSE)) AS d28,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 28 DAY) > to_date, NULL, COALESCE(rf.r28, FALSE)) AS d29,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 29 DAY) > to_date, NULL, COALESCE(rf.r29, FALSE)) AS d30
  ) AS retain,
  STRUCT(
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 1 DAY) > to_date, NULL, COALESCE(rf.rr1, FALSE)) AS d2,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 2 DAY) > to_date, NULL, COALESCE(rf.rr2, FALSE)) AS d3,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 3 DAY) > to_date, NULL, COALESCE(rf.rr3, FALSE)) AS d4,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 4 DAY) > to_date, NULL, COALESCE(rf.rr4, FALSE)) AS d5,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 5 DAY) > to_date, NULL, COALESCE(rf.rr5, FALSE)) AS d6,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 6 DAY) > to_date, NULL, COALESCE(rf.rr6, FALSE)) AS d7,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 7 DAY) > to_date, NULL, COALESCE(rf.rr7, FALSE)) AS d8,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 8 DAY) > to_date, NULL, COALESCE(rf.rr8, FALSE)) AS d9,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 9 DAY) > to_date, NULL, COALESCE(rf.rr9, FALSE)) AS d10,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 10 DAY) > to_date, NULL, COALESCE(rf.rr10, FALSE)) AS d11,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 11 DAY) > to_date, NULL, COALESCE(rf.rr11, FALSE)) AS d12,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 12 DAY) > to_date, NULL, COALESCE(rf.rr12, FALSE)) AS d13,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 13 DAY) > to_date, NULL, COALESCE(rf.rr13, FALSE)) AS d14,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 14 DAY) > to_date, NULL, COALESCE(rf.rr14, FALSE)) AS d15,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 15 DAY) > to_date, NULL, COALESCE(rf.rr15, FALSE)) AS d16,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 16 DAY) > to_date, NULL, COALESCE(rf.rr16, FALSE)) AS d17,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 17 DAY) > to_date, NULL, COALESCE(rf.rr17, FALSE)) AS d18,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 18 DAY) > to_date, NULL, COALESCE(rf.rr18, FALSE)) AS d19,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 19 DAY) > to_date, NULL, COALESCE(rf.rr19, FALSE)) AS d20,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 20 DAY) > to_date, NULL, COALESCE(rf.rr20, FALSE)) AS d21,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 21 DAY) > to_date, NULL, COALESCE(rf.rr21, FALSE)) AS d22,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 22 DAY) > to_date, NULL, COALESCE(rf.rr22, FALSE)) AS d23,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 23 DAY) > to_date, NULL, COALESCE(rf.rr23, FALSE)) AS d24,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 24 DAY) > to_date, NULL, COALESCE(rf.rr24, FALSE)) AS d25,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 25 DAY) > to_date, NULL, COALESCE(rf.rr25, FALSE)) AS d26,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 26 DAY) > to_date, NULL, COALESCE(rf.rr26, FALSE)) AS d27,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 27 DAY) > to_date, NULL, COALESCE(rf.rr27, FALSE)) AS d28,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 28 DAY) > to_date, NULL, COALESCE(rf.rr28, FALSE)) AS d29,
    IF(NOT f.is_active OR DATE_ADD(f.event_date, INTERVAL 29 DAY) > to_date, NULL, COALESCE(rf.rr29, FALSE)) AS d30
  ) AS rolling_retain
FROM output_base AS f
LEFT JOIN lifecycle_flags AS lf USING (event_date, user_pseudo_id)
LEFT JOIN fwd AS fw USING (event_date, user_pseudo_id)
LEFT JOIN retain_flags AS rf USING (event_date, user_pseudo_id)
LEFT JOIN sub_rev AS sr USING (event_date, user_pseudo_id)
LEFT JOIN ad_rev AS ar USING (event_date, user_pseudo_id)
LEFT JOIN rub_rev AS rr USING (event_date, user_pseudo_id);

COMMIT TRANSACTION;

