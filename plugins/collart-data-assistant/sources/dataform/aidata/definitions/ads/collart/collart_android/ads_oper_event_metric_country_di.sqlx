config {
  type: "operations",
  name: "ads_collartandroid_oper_event_metric_country_di",
  schema: "ads_collartandroid",
  dependencies: [
    "ads_collartandroid_oper_event_metric_attr_di"
  ]
}

/*
  Collart Android：日 × 国家 事件指标汇总
  Dataform: definitions/ads/collart/collart_android/ads_oper_event_metric_country_di.sqlx
  目标表  : aidata2025.ads_collartandroid.ads_oper_event_metric_country_di

  口径:
  - 粒度: event_date × country；全量国家（不 top_country）
  - 列名=metric_name 去 *_pv 后缀；STRUCT 内区分 uv/pv
  - 上游: 从表 9 aidata2025.ads_collartandroid.ads_oper_event_metric_attr_di 按 country SUM(uv/pv)
  - 列由 aidata2025.ads_collart.ads_dim_metric_rule is_materialized=true 驱动
    （本文件由 _scratch/gen_event_metric_country_sqlx.py 产出，勿手改）
  - 与表 6 basic_indicator_country 并行：本表只管事件漏斗，不管 DAU/收入/花费
  - 旧 country metric 所需的 new/old/free/vip 切片直接放在对应事件 STRUCT 内：
      如 home_show.new_uv、generate_start.vip_uv、generate_success.vip_pv
*/

DECLARE from_date DATE DEFAULT ${dataform.projectConfig.vars.biz_date} - 30;
DECLARE to_date   DATE DEFAULT ${dataform.projectConfig.vars.biz_date};

CREATE TABLE IF NOT EXISTS `aidata2025.ads_collartandroid.ads_oper_event_metric_country_di`
(
  package_name STRING,
  app_name STRING,
  event_date DATE,
  country STRING,
  img2video_generate_success STRUCT<uv INT64, pv INT64>,
  img2video_generate_start STRUCT<uv INT64, pv INT64>,
  home_show STRUCT<uv INT64, pv INT64, new_uv INT64>,
  home_template_click STRUCT<uv INT64, pv INT64, new_uv INT64>,
  album_show STRUCT<uv INT64, pv INT64, new_uv INT64>,
  generate_ready STRUCT<uv INT64, pv INT64, new_uv INT64>,
  generate_save STRUCT<uv INT64, pv INT64, new_uv INT64>,
  generate_start STRUCT<uv INT64, pv INT64, new_uv INT64, old_uv INT64, free_uv INT64, vip_uv INT64>,
  generate_success STRUCT<uv INT64, pv INT64, new_uv INT64, new_pv INT64, free_pv INT64, vip_pv INT64>,
  video_generate_start STRUCT<uv INT64, pv INT64>,
  framestransition_video_generate_start STRUCT<uv INT64, pv INT64>,
  motioncontrol_video_generate_start STRUCT<uv INT64, pv INT64>,
  text2video_video_generate_start STRUCT<uv INT64, pv INT64>,
  referencetovideo_video_generate_start STRUCT<uv INT64, pv INT64>,
  img2img_generate_start STRUCT<uv INT64, pv INT64>,
  img_generate_start STRUCT<uv INT64, pv INT64>,
  text2img_generate_start STRUCT<uv INT64, pv INT64>,
  aiedit_img2img_generate_start STRUCT<uv INT64, pv INT64>,
  multireference_img2img_generate_start STRUCT<uv INT64, pv INT64>,
  video_generate_success STRUCT<uv INT64, pv INT64>,
  framestransition_video_generate_success STRUCT<uv INT64, pv INT64>,
  motioncontrol_video_generate_success STRUCT<uv INT64, pv INT64>,
  text2video_video_generate_success STRUCT<uv INT64, pv INT64>,
  referencetovideo_video_generate_success STRUCT<uv INT64, pv INT64>,
  img_generate_success STRUCT<uv INT64, pv INT64>,
  img2img_generate_success STRUCT<uv INT64, pv INT64>,
  text2img_generate_success STRUCT<uv INT64, pv INT64>,
  aiedit_img2img_generate_success STRUCT<uv INT64, pv INT64>,
  multireference_img2img_generate_success STRUCT<uv INT64, pv INT64>,
  video_save STRUCT<uv INT64, pv INT64>,
  image_save STRUCT<uv INT64, pv INT64>
)
PARTITION BY event_date
CLUSTER BY country
OPTIONS (
  description = 'Collart Android 日×国家事件指标：由表9 attr 按 country 上卷 uv/pv'
);

BEGIN TRANSACTION;

DELETE FROM `aidata2025.ads_collartandroid.ads_oper_event_metric_country_di`
WHERE event_date BETWEEN from_date AND to_date;

INSERT INTO `aidata2025.ads_collartandroid.ads_oper_event_metric_country_di`
(
  package_name,
  app_name,
  event_date,
  country,
  img2video_generate_success,
  img2video_generate_start,
  home_show,
  home_template_click,
  album_show,
  generate_ready,
  generate_save,
  generate_start,
  generate_success,
  video_generate_start,
  framestransition_video_generate_start,
  motioncontrol_video_generate_start,
  text2video_video_generate_start,
  referencetovideo_video_generate_start,
  img2img_generate_start,
  img_generate_start,
  text2img_generate_start,
  aiedit_img2img_generate_start,
  multireference_img2img_generate_start,
  video_generate_success,
  framestransition_video_generate_success,
  motioncontrol_video_generate_success,
  text2video_video_generate_success,
  referencetovideo_video_generate_success,
  img_generate_success,
  img2img_generate_success,
  text2img_generate_success,
  aiedit_img2img_generate_success,
  multireference_img2img_generate_success,
  video_save,
  image_save
)
SELECT
  'free.ai.photo.generator.collart.ai' AS package_name,
  'collart_android' AS app_name,
  event_date,
  country,
  STRUCT(
    COALESCE(SUM(img2video_generate_success.uv), 0) AS uv,
    COALESCE(SUM(img2video_generate_success.pv), 0) AS pv
  ) AS img2video_generate_success,  -- 图生视频 生成成功
  STRUCT(
    COALESCE(SUM(img2video_generate_start.uv), 0) AS uv,
    COALESCE(SUM(img2video_generate_start.pv), 0) AS pv
  ) AS img2video_generate_start,  -- 图生视频 生成开始
  STRUCT(
    COALESCE(SUM(home_show.uv), 0) AS uv,
    COALESCE(SUM(home_show.pv), 0) AS pv,
    COALESCE(SUM(IF(is_new, home_show.uv, 0)), 0) AS new_uv
  ) AS home_show,  -- 首页曝光
  STRUCT(
    COALESCE(SUM(home_template_click.uv), 0) AS uv,
    COALESCE(SUM(home_template_click.pv), 0) AS pv,
    COALESCE(SUM(IF(is_new, home_template_click.uv, 0)), 0) AS new_uv
  ) AS home_template_click,  -- 首页模板点击
  STRUCT(
    COALESCE(SUM(album_show.uv), 0) AS uv,
    COALESCE(SUM(album_show.pv), 0) AS pv,
    COALESCE(SUM(IF(is_new, album_show.uv, 0)), 0) AS new_uv
  ) AS album_show,  -- 相册曝光
  STRUCT(
    COALESCE(SUM(generate_ready.uv), 0) AS uv,
    COALESCE(SUM(generate_ready.pv), 0) AS pv,
    COALESCE(SUM(IF(is_new, generate_ready.uv, 0)), 0) AS new_uv
  ) AS generate_ready,  -- 生成准备
  STRUCT(
    COALESCE(SUM(generate_save.uv), 0) AS uv,
    COALESCE(SUM(generate_save.pv), 0) AS pv,
    COALESCE(SUM(IF(is_new, generate_save.uv, 0)), 0) AS new_uv
  ) AS generate_save,  -- 生成保存
  STRUCT(
    COALESCE(SUM(generate_start.uv), 0) AS uv,
    COALESCE(SUM(generate_start.pv), 0) AS pv,
    COALESCE(SUM(IF(is_new, generate_start.uv, 0)), 0) AS new_uv,
    COALESCE(SUM(IF(NOT is_new, generate_start.uv, 0)), 0) AS old_uv,
    COALESCE(SUM(IF(NOT IFNULL(is_vip, FALSE), generate_start.uv, 0)), 0) AS free_uv,
    COALESCE(SUM(IF(IFNULL(is_vip, FALSE), generate_start.uv, 0)), 0) AS vip_uv
  ) AS generate_start,  -- 服务调用开始
  STRUCT(
    COALESCE(SUM(generate_success.uv), 0) AS uv,
    COALESCE(SUM(generate_success.pv), 0) AS pv,
    COALESCE(SUM(IF(is_new, generate_success.uv, 0)), 0) AS new_uv,
    COALESCE(SUM(IF(is_new, generate_success.pv, 0)), 0) AS new_pv,
    COALESCE(SUM(IF(NOT IFNULL(is_vip, FALSE), generate_success.pv, 0)), 0) AS free_pv,
    COALESCE(SUM(IF(IFNULL(is_vip, FALSE), generate_success.pv, 0)), 0) AS vip_pv
  ) AS generate_success,  -- 服务调用成功
  STRUCT(
    COALESCE(SUM(video_generate_start.uv), 0) AS uv,
    COALESCE(SUM(video_generate_start.pv), 0) AS pv
  ) AS video_generate_start,  -- 视频生成·开始
  STRUCT(
    COALESCE(SUM(framestransition_video_generate_start.uv), 0) AS uv,
    COALESCE(SUM(framestransition_video_generate_start.pv), 0) AS pv
  ) AS framestransition_video_generate_start,  -- FramesTransition 视频生成·开始
  STRUCT(
    COALESCE(SUM(motioncontrol_video_generate_start.uv), 0) AS uv,
    COALESCE(SUM(motioncontrol_video_generate_start.pv), 0) AS pv
  ) AS motioncontrol_video_generate_start,  -- MotionControl 视频生成·开始
  STRUCT(
    COALESCE(SUM(text2video_video_generate_start.uv), 0) AS uv,
    COALESCE(SUM(text2video_video_generate_start.pv), 0) AS pv
  ) AS text2video_video_generate_start,  -- AItext2video 视频生成·开始
  STRUCT(
    COALESCE(SUM(referencetovideo_video_generate_start.uv), 0) AS uv,
    COALESCE(SUM(referencetovideo_video_generate_start.pv), 0) AS pv
  ) AS referencetovideo_video_generate_start,  -- referencetovideo 生成开始
  STRUCT(
    COALESCE(SUM(img2img_generate_start.uv), 0) AS uv,
    COALESCE(SUM(img2img_generate_start.pv), 0) AS pv
  ) AS img2img_generate_start,  -- 图生图·生成开始
  STRUCT(
    COALESCE(SUM(img_generate_start.uv), 0) AS uv,
    COALESCE(SUM(img_generate_start.pv), 0) AS pv
  ) AS img_generate_start,  -- 图片生成·生成开始
  STRUCT(
    COALESCE(SUM(text2img_generate_start.uv), 0) AS uv,
    COALESCE(SUM(text2img_generate_start.pv), 0) AS pv
  ) AS text2img_generate_start,  -- 文生图·开始
  STRUCT(
    COALESCE(SUM(aiedit_img2img_generate_start.uv), 0) AS uv,
    COALESCE(SUM(aiedit_img2img_generate_start.pv), 0) AS pv
  ) AS aiedit_img2img_generate_start,  -- AIEdit 图生图·开始
  STRUCT(
    COALESCE(SUM(multireference_img2img_generate_start.uv), 0) AS uv,
    COALESCE(SUM(multireference_img2img_generate_start.pv), 0) AS pv
  ) AS multireference_img2img_generate_start,  -- MultiReference 图生图·开始
  STRUCT(
    COALESCE(SUM(video_generate_success.uv), 0) AS uv,
    COALESCE(SUM(video_generate_success.pv), 0) AS pv
  ) AS video_generate_success,  -- 视频生成·成功
  STRUCT(
    COALESCE(SUM(framestransition_video_generate_success.uv), 0) AS uv,
    COALESCE(SUM(framestransition_video_generate_success.pv), 0) AS pv
  ) AS framestransition_video_generate_success,  -- FramesTransition 视频生成·成功
  STRUCT(
    COALESCE(SUM(motioncontrol_video_generate_success.uv), 0) AS uv,
    COALESCE(SUM(motioncontrol_video_generate_success.pv), 0) AS pv
  ) AS motioncontrol_video_generate_success,  -- MotionControl 视频生成·成功
  STRUCT(
    COALESCE(SUM(text2video_video_generate_success.uv), 0) AS uv,
    COALESCE(SUM(text2video_video_generate_success.pv), 0) AS pv
  ) AS text2video_video_generate_success,  -- AItext2video 视频生成·成功
  STRUCT(
    COALESCE(SUM(referencetovideo_video_generate_success.uv), 0) AS uv,
    COALESCE(SUM(referencetovideo_video_generate_success.pv), 0) AS pv
  ) AS referencetovideo_video_generate_success,  -- referencetovideo 生成成功
  STRUCT(
    COALESCE(SUM(img_generate_success.uv), 0) AS uv,
    COALESCE(SUM(img_generate_success.pv), 0) AS pv
  ) AS img_generate_success,  -- 图片生成·生成成功
  STRUCT(
    COALESCE(SUM(img2img_generate_success.uv), 0) AS uv,
    COALESCE(SUM(img2img_generate_success.pv), 0) AS pv
  ) AS img2img_generate_success,  -- 图生图·生成成功
  STRUCT(
    COALESCE(SUM(text2img_generate_success.uv), 0) AS uv,
    COALESCE(SUM(text2img_generate_success.pv), 0) AS pv
  ) AS text2img_generate_success,  -- 文生图·成功
  STRUCT(
    COALESCE(SUM(aiedit_img2img_generate_success.uv), 0) AS uv,
    COALESCE(SUM(aiedit_img2img_generate_success.pv), 0) AS pv
  ) AS aiedit_img2img_generate_success,  -- AIEdit 图生图·成功
  STRUCT(
    COALESCE(SUM(multireference_img2img_generate_success.uv), 0) AS uv,
    COALESCE(SUM(multireference_img2img_generate_success.pv), 0) AS pv
  ) AS multireference_img2img_generate_success,  -- MultiReference 图生图·成功
  STRUCT(
    COALESCE(SUM(video_save.uv), 0) AS uv,
    COALESCE(SUM(video_save.pv), 0) AS pv
  ) AS video_save,  -- 视频保存
  STRUCT(
    COALESCE(SUM(image_save.uv), 0) AS uv,
    COALESCE(SUM(image_save.pv), 0) AS pv
  ) AS image_save  -- 生图保存
FROM `aidata2025.ads_collartandroid.ads_oper_event_metric_attr_di`
WHERE event_date BETWEEN from_date AND to_date
  AND country IS NOT NULL
GROUP BY event_date, country;

COMMIT TRANSACTION;
