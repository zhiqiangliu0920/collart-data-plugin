config {
  type: "operations"
}

/*
  Collart Web / Fashion 事件语义明细
  Dataform: definitions/dm/daily/h_dm_collart_web_user_event_di.sqlx
  目标表  : aidata2025.dm.dm_collart_web_user_event_di

  渠道两层（对齐 Android DM）:
  - traffic_src_type: delivery / inhouse / kol / nature
  - traffic_src_platform: ga_delivery / fb_delivery / x_delivery /
    tt_delivery / applovin_delivery / dc_delivery / other_delivery；非投放沿用 type
  - Web 统计只认 x_delivery；历史短名 x / X 写出时归一，不单独成桶（iOS 投放仍用短名 x）
  - Instagram 属于 Meta，IG campaign / source=ig|instagram 一律 fb_delivery，不再单列 ig_delivery
  - sptt- / tt_official / tt_* / youtube_* / ^kol 保持 kol，只有付费 TikTok 才叫 tt_delivery
  投放识别:
  - 主: traffic_source/param.medium ∈ paid_social,cpc,ppc,paid,display,paid_search,cpv,cpm
  - 兜底: campaign 名、page_location 含 offical / utm_source=X、落地页 utm_medium 为付费、from_app 以 dc_ 开头（DeepClick）
  - from_app 非 dc_ 仍为 inhouse；勿单靠 source=facebook（referral 保持 nature）
*/

DECLARE
  from_date DATE DEFAULT ${dataform.projectConfig.vars.biz_date}-3;
DECLARE
  to_date DATE DEFAULT ${dataform.projectConfig.vars.biz_date};

ALTER TABLE `aidata2025.dm.dm_collart_web_user_event_di`
ADD COLUMN IF NOT EXISTS traffic_src_platform STRING;

BEGIN TRANSACTION;

DELETE FROM `aidata2025.dm.dm_collart_web_user_event_di`
WHERE event_date BETWEEN from_date AND to_date;

INSERT INTO `aidata2025.dm.dm_collart_web_user_event_di` (
  package_name, app_name, event_date, event_time, event_name,
  user_pseudo_id, user_id, is_login, is_vip, country,
  traffic_src_name, traffic_src_type, traffic_src_platform,
  ga_session_id, ga_session_number, session_engaged, engagement_time_msec, first_open_time,
  page, geo, device, traffic, identity, subscription, web_params_info, fashion_params_info
)
WITH raw_events AS (
  SELECT
    PARSE_DATE('%Y%m%d', event_date) AS event_date,
    DATETIME(TIMESTAMP_MICROS(event_timestamp)) AS event_time,
    event_name,
    user_pseudo_id,
    user_id,
    user_first_touch_timestamp,
    geo,
    device,
    traffic_source,
    event_params,
    user_properties,

    (
      SELECT AS STRUCT
        MAX(IF(p.key = 'ga_session_id', v, NULL)) AS ga_session_id,
        MAX(IF(p.key = 'ga_session_number', v, NULL)) AS ga_session_number,
        MAX(IF(p.key = 'session_engaged', v, NULL)) AS session_engaged,
        MAX(IF(p.key = 'engagement_time_msec', v, NULL)) AS engagement_time_msec,
        MAX(IF(p.key = 'page_location', v, NULL)) AS page_location,
        MAX(IF(p.key = 'page_title', v, NULL)) AS page_title,
        MAX(IF(p.key = 'page_referrer', v, NULL)) AS page_referrer,
        MAX(IF(p.key = 'page_name', v, NULL)) AS page_name,
        MAX(IF(p.key = 'browser_version', v, NULL)) AS browser_version,
        MAX(IF(p.key = 'source', v, NULL)) AS source,
        MAX(IF(p.key = 'medium', v, NULL)) AS medium,
        MAX(IF(p.key = 'campaign', v, NULL)) AS campaign,
        MAX(IF(p.key = 'campaign_id', v, NULL)) AS campaign_id,
        MAX(IF(p.key = 'term', v, NULL)) AS term,
        MAX(IF(p.key = 'content', v, NULL)) AS content,
        MAX(IF(p.key = 'clarity_session_id', v, NULL)) AS clarity_session_id,
        MAX(IF(p.key = 'clarity_user_id', v, NULL)) AS clarity_user_id,
        MAX(IF(p.key = 'atlasv_id', v, NULL)) AS atlasv_id,

        -- subscription
        MAX(IF(p.key = 'product_id', v, NULL)) AS product_id,
        MAX(IF(p.key = 'price', v, NULL)) AS price,
        MAX(IF(p.key = 'currency', v, NULL)) AS currency,
        MAX(IF(p.key = 'points', v, NULL)) AS points,
        MAX(IF(p.key = 'product_type', v, NULL)) AS product_type,

        -- web_params_info
        MAX(IF(p.key = 'service_type', v, NULL)) AS service_type,
        MAX(IF(p.key = 'task_id', v, NULL)) AS task_id,
        MAX(IF(p.key = 'feature', v, NULL)) AS feature,
        MAX(IF(p.key = 'from', v, NULL)) AS event_from,
        MAX(IF(p.key = 'category', v, NULL)) AS category,
        MAX(IF(p.key = 'module_type', v, NULL)) AS module_type,
        MAX(IF(p.key = 'entry', v, NULL)) AS entry,
        MAX(IF(p.key = 'template_id', v, NULL)) AS web_template_id,
        MAX(IF(p.key = 'list_source', v, NULL)) AS list_source,
        MAX(IF(p.key = 'result_id', v, NULL)) AS result_id,
        MAX(IF(p.key = 'result_type', v, NULL)) AS result_type,
        MAX(IF(p.key = 'target_path', v, NULL)) AS target_path,
        MAX(IF(p.key = 'total_ms', v, NULL)) AS total_ms,
        MAX(IF(p.key = 'success', v, NULL)) AS success,
        MAX(IF(p.key = 'model', v, NULL)) AS model,
        MAX(IF(p.key = 'model_type', v, NULL)) AS model_type,
        MAX(IF(p.key = 'model_value', v, NULL)) AS model_value,
        MAX(IF(p.key = 'keyword', v, NULL)) AS keyword,
        MAX(IF(p.key = 'search_keyword', v, NULL)) AS click_search_keyword,

        -- fashion_params_info
        MAX(IF(p.key = 'step', v, NULL)) AS step,
        MAX(IF(p.key = 'module_name', v, NULL)) AS module_name,
        MAX(IF(p.key = 'template_id', v, NULL)) AS template_id,
        MAX(IF(p.key = 'model_source', v, NULL)) AS model_source,
        MAX(IF(p.key = 'model_preset_id', v, NULL)) AS model_preset_id,
        MAX(IF(p.key = 'outfit_type', v, NULL)) AS outfit_type,
        MAX(IF(p.key = 'outfit_preset_id', v, NULL)) AS outfit_preset_id,
        MAX(IF(p.key = 'outfit_count', v, NULL)) AS outfit_count,
        MAX(IF(p.key = 'video_model', v, NULL)) AS video_model,
        MAX(IF(p.key = 'resolution', v, NULL)) AS resolution,
        MAX(IF(p.key = 'bgm_enabled', v, NULL)) AS bgm_enabled,
        MAX(IF(p.key = 'has_prompt', v, NULL)) AS has_prompt,
        MAX(IF(p.key = 'has_scene', v, NULL)) AS has_scene,
        MAX(IF(p.key = 'generate_count', v, NULL)) AS generate_count
      FROM (
        SELECT
          p.key,
          COALESCE(
            CAST(p.value.int_value AS STRING),
            p.value.string_value,
            CAST(p.value.float_value AS STRING),
            CAST(p.value.double_value AS STRING)
          ) AS v
        FROM UNNEST(event_params) AS p
      ) p
    ) AS param,

    (
      SELECT
        COALESCE(
          CAST(up.value.int_value AS STRING),
          up.value.string_value,
          CAST(up.value.float_value AS STRING),
          CAST(up.value.double_value AS STRING)
        )
      FROM UNNEST(user_properties) AS up
      WHERE up.key = 'clarity_user_id'
      LIMIT 1
    ) AS property_clarity_user_id,

    (
      SELECT
        COALESCE(
          CAST(up.value.int_value AS STRING),
          up.value.string_value,
          CAST(up.value.float_value AS STRING),
          CAST(up.value.double_value AS STRING)
        )
      FROM UNNEST(user_properties) AS up
      WHERE up.key IN ('is_vip', 'vip_type')
      LIMIT 1
    ) AS property_is_vip,

    (
      SELECT
        COALESCE(
          CAST(up.value.int_value AS STRING),
          up.value.string_value,
          CAST(up.value.float_value AS STRING),
          CAST(up.value.double_value AS STRING)
        )
      FROM UNNEST(user_properties) AS up
      WHERE up.key = 'from_app'
      LIMIT 1
    ) AS property_from_app,

    (
      SELECT
        COALESCE(
          CAST(up.value.int_value AS STRING),
          up.value.string_value,
          CAST(up.value.float_value AS STRING),
          CAST(up.value.double_value AS STRING)
        )
      FROM UNNEST(user_properties) AS up
      WHERE up.key = 'traffic_srouce_name'
      LIMIT 1
    ) AS property_traffic_srouce_name

  FROM `storytemplate-10a27.analytics_232977577.events_*`
  WHERE ( _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', from_date)
    AND FORMAT_DATE('%Y%m%d', to_date)
    OR _TABLE_SUFFIX BETWEEN CONCAT('intraday_', FORMAT_DATE('%Y%m%d', from_date))
    AND CONCAT('intraday_', FORMAT_DATE('%Y%m%d', to_date))
    )
    AND app_info.id IS NULL
    AND user_pseudo_id IS NOT NULL
    AND event_name NOT LIKE 'tech%'
    AND event_name NOT LIKE 'dev%'
    AND event_name NOT IN (
      'fire_base_start_request',
      'isGooglePlayServicesAvailable',
      'fire_base_end_request',
      'launch',
      'gp_query_purchases',
      'gp_query_purchases_result'
    )
),

enriched AS (
SELECT
  event_date,
  event_time,
  event_name,
  CASE
    WHEN REGEXP_CONTAINS(
      LOWER(COALESCE(param.page_location, '')),
      r'studio|fashion'
    ) THEN 'collart_fashion'
    ELSE 'collart_web'
  END AS package_name,
  user_pseudo_id,
  user_id,
  (user_id IS NOT NULL AND user_id != '') AS is_login,
  COALESCE(property_is_vip, '0') AS is_vip,
  geo.country AS country,
  IF(
    traffic_source.name = '' OR traffic_source.name IS NULL,
    'undefined',
    traffic_source.name
  ) AS traffic_src_name,
  -- 达人前缀优先于 delivery：sptt- / tt_official 保持 kol，付费 TT 靠 source/campaign 进 tt_delivery
  CASE
    WHEN REGEXP_CONTAINS(LOWER(COALESCE(traffic_source.name, '')), r'^(kol|sptt-|spytb-|tt_|youtube_)')
      OR REGEXP_CONTAINS(LOWER(COALESCE(property_traffic_srouce_name, '')), r'^(kol|sptt-|spytb-|tt_|youtube_)') THEN 'kol'
    WHEN LOWER(COALESCE(traffic_source.medium, param.medium, '')) IN (
      'paid_social', 'cpc', 'ppc', 'paid', 'display', 'paid_search', 'cpv', 'cpm'
    ) THEN 'delivery'
    WHEN LOWER(REGEXP_EXTRACT(COALESCE(param.page_location, ''), r'[?&]utm_medium=([^&#]+)')) IN (
      'paid_social', 'cpc', 'ppc', 'paid', 'display', 'paid_search', 'cpv', 'cpm'
    ) THEN 'delivery'
    WHEN LOWER(COALESCE(traffic_source.name, '')) LIKE '%fb%collart%'
      OR LOWER(COALESCE(traffic_source.name, '')) LIKE '%ga%collart%'
      OR LOWER(COALESCE(traffic_source.name, '')) LIKE '%meta%collart%'
      OR REGEXP_CONTAINS(LOWER(COALESCE(traffic_source.name, '')), r'^fb[-_]?cw')
      OR REGEXP_CONTAINS(LOWER(COALESCE(traffic_source.name, '')), r'^ga[-_]?cw')
      OR LOWER(COALESCE(traffic_source.name, '')) LIKE '%sea%'
      OR COALESCE(param.page_location, '') LIKE '%offical%'
      OR COALESCE(param.page_location, '') LIKE '%utm_source=X%' THEN 'delivery'
    WHEN REGEXP_CONTAINS(LOWER(COALESCE(property_from_app, '')), r'^dc_') THEN 'delivery'
    WHEN property_from_app IS NOT NULL THEN 'inhouse'
    WHEN LOWER(COALESCE(traffic_source.name, '')) LIKE '%kol%'
      OR LOWER(COALESCE(property_traffic_srouce_name, '')) LIKE '%kol%' THEN 'kol'
    ELSE 'nature'
  END AS traffic_src_type,
  COALESCE(traffic_source.source, param.source) AS _src,
  COALESCE(traffic_source.medium, param.medium) AS _medium,
  property_from_app AS _from_app,
  SAFE_CAST(param.ga_session_id AS INT64) AS ga_session_id,
  SAFE_CAST(param.ga_session_number AS INT64) AS ga_session_number,
  param.session_engaged IN ('1', 'true') AS session_engaged,
  SAFE_CAST(param.engagement_time_msec AS INT64) AS engagement_time_msec,
  TIMESTAMP_MICROS(user_first_touch_timestamp) AS first_open_time,

  STRUCT(
    param.page_location AS location,
    param.page_title AS title,
    param.page_referrer AS referrer,
    param.page_name AS name
  ) AS page,

  STRUCT(
    geo.city,
    geo.continent,
    geo.sub_continent
  ) AS geo,

  STRUCT(
    device.category AS device_category,
    device.mobile_brand_name,
    device.mobile_model_name,
    device.operating_system,
    device.operating_system_version AS device_operating_system_version,
    device.vendor_id AS device_vendor_id,
    device.language AS device_language,
    device.web_info.browser AS browser,
    param.browser_version AS browser_version
  ) AS device,

  STRUCT(
    COALESCE(traffic_source.source, param.source) AS source,
    COALESCE(traffic_source.medium, param.medium) AS medium,
    param.campaign,
    param.campaign_id,
    param.term,
    param.content
  ) AS traffic,

  STRUCT(
    COALESCE(param.clarity_user_id, property_clarity_user_id) AS clarity_user_id,
    param.clarity_session_id AS clarity_session_id,
    param.atlasv_id AS atlasv_id
  ) AS identity,

  STRUCT(
    param.product_id,
    param.price,
    param.currency,
    param.points,
    param.product_type
  ) AS subscription,

  STRUCT(
    param.service_type,
    param.task_id,
    param.feature,
    param.event_from,
    param.category,
    param.module_type,
    param.entry,
    param.web_template_id AS template_id,
    param.list_source,
    param.result_id,
    param.result_type,
    param.target_path,
    SAFE_CAST(param.total_ms AS FLOAT64) AS total_ms,
    param.success,
    param.model,
    param.model_type,
    param.model_value,
    CASE
      WHEN event_name = 'explore_content_click' THEN param.click_search_keyword
      WHEN event_name IN ('explore_search_submit', 'explore_search_zero_results') THEN param.keyword
      ELSE NULL
    END AS search_keyword
  ) AS web_params_info,

  STRUCT(
    param.step,
    param.module_name,
    param.template_id,
    param.model_source,
    param.model_preset_id,
    param.outfit_type,
    param.outfit_preset_id,
    SAFE_CAST(param.outfit_count AS INT64) AS outfit_count,
    param.video_model,
    param.resolution,
    param.bgm_enabled,
    param.has_prompt,
    param.has_scene,
    SAFE_CAST(param.generate_count AS INT64) AS generate_count
  ) AS fashion_params_info

FROM raw_events
),

channelized AS (
  SELECT
    * EXCEPT(_src, _medium, _from_app),
    CASE
      WHEN traffic_src_type != 'delivery' THEN traffic_src_type
      WHEN LOWER(COALESCE(_src, '')) IN ('x', 'twitter')
        OR COALESCE(page.location, '') LIKE '%utm_source=X%'
        OR REGEXP_CONTAINS(UPPER(COALESCE(traffic_src_name, '')), r'^(X[-_]|CW_X_|TW[-_]|TWITTER)') THEN 'x_delivery'
      WHEN LOWER(COALESCE(_src, '')) LIKE '%tiktok%'
        OR LOWER(COALESCE(_src, '')) LIKE '%bytedance%'
        OR LOWER(REGEXP_EXTRACT(COALESCE(page.location, ''), r'[?&]utm_source=([^&#]+)')) LIKE '%tiktok%'
        OR REGEXP_CONTAINS(UPPER(COALESCE(traffic_src_name, '')), r'^(TT[-]|TIKTOK)') THEN 'tt_delivery'
      WHEN UPPER(COALESCE(traffic_src_name, '')) LIKE 'GA-%'
        OR REGEXP_CONTAINS(LOWER(COALESCE(traffic_src_name, '')), r'^ga[-_]?cw')
        OR (LOWER(COALESCE(_src, '')) = 'google' AND LOWER(COALESCE(_medium, '')) IN ('cpc', 'ppc', 'paid', 'paid_search', 'display', 'cpv', 'cpm')) THEN 'ga_delivery'
      WHEN UPPER(COALESCE(traffic_src_name, '')) LIKE 'FB%'
        OR UPPER(COALESCE(traffic_src_name, '')) LIKE 'IG%'
        OR LOWER(COALESCE(traffic_src_name, '')) LIKE '%meta%collart%'
        OR REGEXP_CONTAINS(LOWER(COALESCE(traffic_src_name, '')), r'^fb[-_]?cw')
        OR LOWER(COALESCE(_src, '')) LIKE '%facebook%'
        OR LOWER(COALESCE(_src, '')) IN ('fb', 'ig', 'instagram')
        OR LOWER(COALESCE(_medium, '')) = 'paid_social' THEN 'fb_delivery'
      WHEN LOWER(COALESCE(_src, '')) LIKE '%applovin%' THEN 'applovin_delivery'
      WHEN REGEXP_CONTAINS(LOWER(COALESCE(_from_app, '')), r'^dc_') THEN 'dc_delivery'
      ELSE 'other_delivery'
    END AS traffic_src_platform
  FROM enriched
)

SELECT
  package_name,
  CASE WHEN package_name = 'collart_fashion' THEN 'collart_fashion' ELSE 'collart_web' END AS app_name,
  event_date,
  event_time,
  event_name,
  user_pseudo_id,
  user_id,
  is_login,
  is_vip,
  country,
  traffic_src_name,
  traffic_src_type,
  IF(LOWER(IFNULL(traffic_src_platform, '')) IN ('x', 'x_delivery'), 'x_delivery', traffic_src_platform) AS traffic_src_platform,
  ga_session_id,
  ga_session_number,
  session_engaged,
  engagement_time_msec,
  first_open_time,
  page,
  geo,
  device,
  traffic,
  identity,
  subscription,
  web_params_info,
  fashion_params_info
FROM channelized;

COMMIT;
